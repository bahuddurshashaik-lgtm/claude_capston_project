# Confluence MCP Server Configuration

# Your Confluence base URL (without /wiki at the end)
CONFLUENCE_BASE_URL=https://bahuddurshashaik.atlassian.net/wiki

# Your Atlassian account email
CONFLUENCE_EMAIL=your-email@example.com

# Your Atlassian API token
# Generate one at: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=your-api-token-here

# Confluence space key (default: ClaudeCpas)
CONFLUENCE_SPACE_KEY=ClaudeCpas
